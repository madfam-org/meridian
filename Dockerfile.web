# Meridian Web — ghcr.io/madfam-org/meridian-web
#
# The applicant portal. Build context is the repository root because the app
# imports @meridian/core, @meridian/pathways and @meridian/presence through the
# workspace.
#
# Requires `output: 'standalone'` in apps/web/next.config.mjs — the runner stage
# copies `.next/standalone`, and the builder asserts it exists so the failure
# arrives with an explanation rather than as "COPY failed: no source files".
#
# Workspace packages are consumed as emitted JavaScript: each builds to `dist/`
# and points its exports default condition there, so apps/web/next.config.mjs
# carries no `transpilePackages` and no `experimental.extensionAlias`, and must
# not regain either — the emitted tree has real `.js` files at the paths those
# settings would remap. The build below runs `--filter "@meridian/web..."`,
# whose trailing dots build the workspace dependencies first; without their
# `dist/` the imports resolve to nothing.

FROM node:22-alpine AS deps

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/admin/package.json ./apps/admin/
COPY apps/landing/package.json ./apps/landing/
COPY packages/atlas/package.json ./packages/atlas/
COPY packages/core/package.json ./packages/core/
COPY packages/mrtd/package.json ./packages/mrtd/
COPY packages/presence/package.json ./packages/presence/
COPY packages/pathways/package.json ./packages/pathways/
COPY packages/documents/package.json ./packages/documents/
COPY packages/govtech/package.json ./packages/govtech/
COPY packages/i18n/package.json ./packages/i18n/

RUN pnpm install --frozen-lockfile


FROM deps AS build

WORKDIR /app

COPY tsconfig.base.json turbo.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# No NEXT_PUBLIC_* build arguments. Three were declared here — API URL, Janua
# URL, Janua client id — and inlined into the bundle by `next build`. Nothing
# read them: `grep -rn NEXT_PUBLIC apps packages` matches nothing, so the values
# were baked into a publicly pullable image's history to be read by no code at
# all, while telling anyone who opened this file that the portal was wired to
# the API.
#
# When apps/web does start calling the API, the value has to arrive as a build
# argument here as well as in the runtime environment, because Next substitutes
# NEXT_PUBLIC_* at build time and a runtime-only value never reaches the client
# bundle. Add the ARG, the ENV, the --build-arg in
# .github/workflows/build-deploy.yml and the runtime declaration in enclii.yaml
# and infra/k8s/production/web-deployment.yaml in one change — and keep it to
# public, non-secret endpoints, since a build argument is readable by anyone who
# can pull the image.

ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter "@meridian/web..." build

RUN set -eu; \
    if [ ! -d apps/web/.next/standalone ]; then \
      echo "next build produced no .next/standalone directory."; \
      echo "Set output: 'standalone' in apps/web/next.config.* — the runtime"; \
      echo "image copies that tree and has no other way to start the server."; \
      exit 1; \
    fi; \
    mkdir -p apps/web/public


FROM node:22-alpine AS runner

WORKDIR /app

# uid/gid 1001 matches the pod securityContext in
# infra/k8s/production/web-deployment.yaml.
RUN addgroup --system --gid 1001 meridian && \
    adduser --system --uid 1001 --ingroup meridian meridian

# The standalone tree already carries a pruned production node_modules; static
# assets and public files are not traced into it and are copied separately.
COPY --from=build --chown=meridian:meridian /app/apps/web/.next/standalone ./
COPY --from=build --chown=meridian:meridian /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=meridian:meridian /app/apps/web/public ./apps/web/public

# The process entry, and the assertion that it is real.
#
# Next 15.1.3 copies its internal router signal `x-middleware-rewrite` onto the
# CLIENT response for every rewrite this app performs, with no same-origin
# check — measured on this repo's own standalone output. It cannot be removed in
# middleware.ts (Next reads the rewrite out of that very response object, so
# deleting it there cancels the rewrite and serves a blank 200) and next.config
# `headers()` is applied earlier in the route list than the branch that writes
# it. `server-entry.mjs` drops it on the Node response after routing is decided.
# See that file's header for the two lines of Next and the measurement.
COPY --from=build --chown=meridian:meridian /app/apps/web/server-entry.mjs ./apps/web/server-entry.mjs

# A missing or gutted entry must fail the BUILD, not produce a container that
# starts happily and leaks. The CMD below names a file; nothing else checks that
# the file exists, still filters, or still hands over to the server it wraps —
# and all three failures look identical at runtime: a healthy pod serving the
# header. Do not weaken this to a warning, which is the same as deleting it but
# harder to notice.
RUN set -eu; \
    entry="apps/web/server-entry.mjs"; \
    if [ ! -f "$entry" ]; then \
      echo "FATAL: $entry is missing from the image." >&2; \
      echo "The CMD starts it. Without it the container cannot boot at all." >&2; \
      exit 1; \
    fi; \
    if ! grep -q 'x-middleware-rewrite' "$entry"; then \
      echo "FATAL: $entry no longer filters x-middleware-rewrite." >&2; \
      echo "The pod would start, pass its health check, and publish the internal" >&2; \
      echo "route name of every rewrite to every visitor." >&2; \
      exit 1; \
    fi; \
    if ! grep -qE "await import\(['\"]\./server\.js['\"]\)" "$entry"; then \
      echo "FATAL: $entry does not hand over to ./server.js." >&2; \
      echo "The container would install a filter and then serve nothing." >&2; \
      exit 1; \
    fi; \
    if [ ! -f "apps/web/server.js" ]; then \
      echo "FATAL: apps/web/server.js is missing — the entry imports it." >&2; \
      exit 1; \
    fi; \
    echo "response-header filter entry present and wired"


USER meridian

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["node", "apps/web/server-entry.mjs"]
