{
  "name": "@meridian/api",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian API — matters, presence, documents, pathways, and the advice-boundary gate",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@meridian/core": "workspace:*",
    "@meridian/documents": "workspace:*",
    "@meridian/govtech": "workspace:*",
    "@meridian/mrtd": "workspace:*",
    "@meridian/pathways": "workspace:*",
    "@meridian/presence": "workspace:*",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
