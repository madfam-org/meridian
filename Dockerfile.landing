# Meridian Landing — ghcr.io/madfam-org/meridian/landing
#
# Note the nested path. The other three images predate the landing split and use
# the flat form `madfam-org/meridian-<part>`; this one is newer and uses the
# nested form Avala and Enclii already publish under. The workflow, the
# Deployment and kustomization.yaml all agree on the nested name.
#
# The marketing site served at meridian.madfam.io. The applicant portal moved to
# meridian-app.madfam.io when the two were split; this image is not that one.
#
# Build context is the repository root because the site imports @meridian/core
# and @meridian/pathways through the workspace. That is deliberate rather than
# incidental: the figures this site publishes — how many pathways ship, how many
# counsel has signed off — are counted from the real catalog at build time, so
# the image cannot be built without the packages it makes claims about.
#
# Requires `output: 'standalone'` in apps/landing/next.config.* — the runner
# stage copies `.next/standalone`, and the builder asserts it exists so the
# failure arrives with an explanation rather than as "COPY failed: no source
# files".
#
# Workspace packages are consumed as emitted JavaScript (each builds to dist/ and
# its exports default condition points there), so no transpilePackages entry is
# needed here. The build below runs `--filter "@meridian/landing..."`, whose
# trailing dots build the workspace dependencies first; without their dist/ the
# catalog import resolves to nothing.

FROM node:22-alpine AS deps

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/admin/package.json ./apps/admin/
COPY apps/landing/package.json ./apps/landing/
COPY packages/atlas/package.json ./packages/atlas/
COPY packages/core/package.json ./packages/core/
COPY packages/mrtd/package.json ./packages/mrtd/
COPY packages/presence/package.json ./packages/presence/
COPY packages/pathways/package.json ./packages/pathways/
COPY packages/documents/package.json ./packages/documents/
COPY packages/govtech/package.json ./packages/govtech/
COPY packages/i18n/package.json ./packages/i18n/

RUN pnpm install --frozen-lockfile


FROM deps AS build

WORKDIR /app

COPY tsconfig.base.json turbo.json ./
COPY packages/ ./packages/
COPY apps/landing/ ./apps/landing/

# No NEXT_PUBLIC_* build arguments. This site calls no API and holds no client
# configuration: its only outbound links are the repository and the portal, and
# both are constants in apps/landing/lib/links.ts where a reviewer can see them.
# A build argument is recorded in the image history and is readable by anyone who
# can pull the image, and this image is published to a public registry — so the
# right number of them is zero until something genuinely needs one.
#
# CI used to pass `--build-arg NEXT_PUBLIC_APP_URL=...` into this build. No stage
# here declares that ARG, so BuildKit discarded it with a warning nobody reads,
# and the value reached neither the bundle nor the image. The --build-arg line is
# gone from .github/workflows/build-deploy.yml; do not restore it without adding
# the ARG, and do not add the ARG without code that reads the variable.

ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter "@meridian/landing..." build

RUN set -eu; \
    if [ ! -d apps/landing/.next/standalone ]; then \
      echo "next build produced no .next/standalone directory."; \
      echo "Set output: 'standalone' in apps/landing/next.config.* — the runtime"; \
      echo "image copies that tree and has no other way to start the server."; \
      exit 1; \
    fi; \
    mkdir -p apps/landing/public


FROM node:22-alpine AS runner

WORKDIR /app

# uid/gid 1001 matches the pod securityContext in
# infra/k8s/production/landing-deployment.yaml.
RUN addgroup --system --gid 1001 meridian && \
    adduser --system --uid 1001 --ingroup meridian meridian

# The standalone tree already carries a pruned production node_modules; static
# assets and public files are not traced into it and are copied separately.
COPY --from=build --chown=meridian:meridian /app/apps/landing/.next/standalone ./
COPY --from=build --chown=meridian:meridian /app/apps/landing/.next/static ./apps/landing/.next/static
COPY --from=build --chown=meridian:meridian /app/apps/landing/public ./apps/landing/public

# The process entry, and the assertion that it is real.
#
# Next 15.1.3 copies its internal router signal `x-middleware-rewrite` onto the
# CLIENT response for every rewrite this app performs, with no same-origin
# check — measured on this repo's own standalone output. It cannot be removed in
# middleware.ts (Next reads the rewrite out of that very response object, so
# deleting it there cancels the rewrite and serves a blank 200) and next.config
# `headers()` is applied earlier in the route list than the branch that writes
# it. `server-entry.mjs` drops it on the Node response after routing is decided.
# See that file's header for the two lines of Next and the measurement.
COPY --from=build --chown=meridian:meridian /app/apps/landing/server-entry.mjs ./apps/landing/server-entry.mjs

# A missing or gutted entry must fail the BUILD, not produce a container that
# starts happily and leaks. The CMD below names a file; nothing else checks that
# the file exists, still filters, or still hands over to the server it wraps —
# and all three failures look identical at runtime: a healthy pod serving the
# header. Do not weaken this to a warning, which is the same as deleting it but
# harder to notice.
RUN set -eu; \
    entry="apps/landing/server-entry.mjs"; \
    if [ ! -f "$entry" ]; then \
      echo "FATAL: $entry is missing from the image." >&2; \
      echo "The CMD starts it. Without it the container cannot boot at all." >&2; \
      exit 1; \
    fi; \
    if ! grep -q 'x-middleware-rewrite' "$entry"; then \
      echo "FATAL: $entry no longer filters x-middleware-rewrite." >&2; \
      echo "The pod would start, pass its health check, and publish the internal" >&2; \
      echo "route name of every rewrite to every visitor." >&2; \
      exit 1; \
    fi; \
    if ! grep -qE "await import\(['\"]\./server\.js['\"]\)" "$entry"; then \
      echo "FATAL: $entry does not hand over to ./server.js." >&2; \
      echo "The container would install a filter and then serve nothing." >&2; \
      exit 1; \
    fi; \
    if [ ! -f "apps/landing/server.js" ]; then \
      echo "FATAL: apps/landing/server.js is missing — the entry imports it." >&2; \
      exit 1; \
    fi; \
    echo "response-header filter entry present and wired"


USER meridian

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["node", "apps/landing/server-entry.mjs"]
